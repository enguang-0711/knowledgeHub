{
  "name": "software-testing-quality-knowledge-base",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.10.0"
  },
  "scripts": {
    "model:adas-calibration": "node tools/vehicle-vision-anatomy/build.mjs",
    "model:adas-calibration:verify": "node tools/vehicle-vision-anatomy/build.mjs --verify",
    "model:adas-calibration:audit": "node tools/vehicle-vision-anatomy/build.mjs --audit",
    "model:surround-parking": "node tools/vehicle-vision-parking/build.mjs",
    "model:surround-parking:verify": "node tools/vehicle-vision-parking/build.mjs --verify",
    "model:surround-parking:audit": "node tools/vehicle-vision-parking/build.mjs --audit",
    "model:adas-road": "node tools/vehicle-vision-adas-road/build.mjs",
    "model:adas-road:verify": "node tools/vehicle-vision-adas-road/build.mjs --verify",
    "model:adas-road:audit": "node tools/vehicle-vision-adas-road/build.mjs --audit",
    "model:dms-cabin": "node tools/vehicle-vision-dms-cabin/build.mjs",
    "model:dms-cabin:verify": "node tools/vehicle-vision-dms-cabin/build.mjs --verify",
    "model:dms-cabin:audit": "node tools/vehicle-vision-dms-cabin/build.mjs --audit",
    "docs:dev": "npm run model:adas-calibration && npm run model:surround-parking && npm run model:adas-road && npm run model:dms-cabin && vitepress dev docs",
    "docs:build": "npm run model:adas-calibration && npm run model:surround-parking && npm run model:adas-road && npm run model:dms-cabin && vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "hooks:install": "git config core.hooksPath .githooks"
  },
  "devDependencies": {
    "vitepress": "^1.6.4"
  }
}
