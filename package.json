{
  "name": "software-testing-quality-knowledge-base",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.10.0"
  },
  "scripts": {
    "model:adas-calibration": "node tools/vehicle-vision-anatomy/build.mjs",
    "model:adas-calibration:verify": "node tools/vehicle-vision-anatomy/build.mjs --verify",
    "model:adas-calibration:audit": "node tools/vehicle-vision-anatomy/build.mjs --audit",
    "model:surround-parking": "node tools/vehicle-vision-parking/build.mjs",
    "model:surround-parking:verify": "node tools/vehicle-vision-parking/build.mjs --verify",
    "model:surround-parking:audit": "node tools/vehicle-vision-parking/build.mjs --audit",
    "docs:dev": "npm run model:adas-calibration && npm run model:surround-parking && vitepress dev docs",
    "docs:build": "npm run model:adas-calibration && npm run model:surround-parking && vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "hooks:install": "git config core.hooksPath .githooks"
  },
  "devDependencies": {
    "vitepress": "^1.6.4"
  }
}
